{
	// "ts-node": {
	// 	"swc": true,
	// 	"esm": true
	// 	"experimentalSpecifierResolution": "node"
	// },
	"compilerOptions": {
		"typeRoots": ["node_modules/@types", "./typings"],
		// types设置typeRoots目录下需要包括在编译之中的类型模块。默认情况下，该目录下的所有类型模块，都会自动包括在编译之中
		"types": ["node"],
		"baseUrl": ".",
		"rootDir": "./",
		// 路径映射，别名
		"paths": {
			"*": ["node_modules/*"],
			"@/*": ["./src/*"],
			"typings/*": ["typings/*"]
		},
		"outDir": "dist",
		"useDefineForClassFields": true,

		// 一个模块导入解析算法，模仿Node.js实时搜索模块的方式
		"target": "ESNext",
		// "module": "ESNext",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"lib": ["ESNext", "dom"], // "esnext.asynciterable"
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		// 确保每个文件都是独立的模块
		"isolatedModules": true,
		"noEmit": true,
		// esModuleInterop允许我们将ES6模块编译为commonjs模块
		"esModuleInterop": true,
		"declaration": true,
		"jsx": "preserve",

		/* Linting */
		"strict": true,
		"sourceMap": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"skipLibCheck": true,
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"preserveConstEnums": true,
		"removeComments": false
	},
	"include": ["src/*.ts", "src/**/*.ts", "src/*.cts", "src/**/*.cts", "src/**/**/*.cts", "src/**/*.d.ts", "src/**/*.d.cts"],
	"exclude": ["node_modules"],
	"files": []
	// “项目引用（Project References）” 功能，允许用户为项目的不同部分使用不同的 TypeScript 配置。, "src/router/index.cts"
	// "references": [{ "path": "./tsconfig.node.json" }]
}
