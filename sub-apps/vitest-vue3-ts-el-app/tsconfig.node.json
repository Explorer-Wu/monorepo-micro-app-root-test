{
	"include": [
		"vite.config.*",
		"vitest.config.*",
		"cypress.config.*",
		"nightwatch.conf.*",
		"playwright.config.*"
	],
	"compilerOptions": {
		"composite": true,
		"module": "ESNext",
		"types": ["node"],
		"moduleResolution": "Node",
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true
	}
}
