{
	"name": "vitest-latest-ts-base",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:local": "pnpm dev --mode _local",
		"testing": "pnpm dev --mode testing",
		"staging": "pnpm dev --mode staging",
		"build:testing": "pnpm build-only --mode testing && pnpm type-check",
		"build:staging": "pnpm build-only --mode staging && pnpm tsc-only",
		"build:prod": "pnpm build-only --mode production && pnpm tsc-prod",
		"build-only": "vite build",
		"analyze": "source-map-explorer 'dist/dist_staging/main-vite-react/assets/*.js'",
		"preview": "vite preview",
		"tsc-prod": "tsc -p ./tsconfig.prod.json",
		"tsc-only": "tsc --noEmit",
		"type-check": "tsc --noEmit -p tsconfig.test.json --composite false",
		"lint-staged": "lint-staged",
		"lint:biome": "biome lint --write .",
		"format": "biome format --write .",
		"lint:oxc": "oxlint --deny-warnings .",
		"lint:oxc:fix": "oxlint --fix .",
		"check:fast": "pnpm lint:oxc && pnpm tsc-only",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts"
	},
	"dependencies": {
		"@ant-design/icons": "6.2.2",
		"@micro-zoe/micro-app": "1.0.0-rc.30",
		"antd": "6.3.7",
		"axios-ajax-ts": "workspace:^",
		"classnames": "2.5.1",
		"dayjs": "1.11.20",
		"immer": "^10.2.0",
		"lodash-es": "4.18.1",
		"mockjs": "1.1.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router-dom": "7.14.2",
		"use-immer": "^0.9.0",
		"zustand": "5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/bmapgl": "0.0.7",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^24.12.4",
		"@types/postcss-pxtorem": "^6.1.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@types/react-router-dom": "^5.3.3",
		"@unoCSS/preset-attributify": "npm:@unocss/preset-attributify@^0.58.9",
		"@unoCSS/preset-icons": "npm:@unocss/preset-icons@^0.58.9",
		"@unoCSS/preset-uno": "npm:@unocss/preset-uno@^0.58.9",
		"@vitejs/plugin-basic-ssl": "^1.2.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "4.1.5",
		"@vitest/ui": "^1.6.1",
		"code-inspector-plugin": "^0.20.17",
		"echarts": "^5.6.0",
		"echarts-for-react": "^3.0.6",
		"globals": "^17.6.0",
		"jsdom": "29.1.1",
		"less": "^4.6.4",
		"lint-staged": "^15.5.2",
		"postcss": "^8.5.15",
		"postcss-load-config": "^5.1.0",
		"postcss-preset-env": "^9.6.0",
		"postcss-pxtorem": "^6.1.0",
		"rollup-plugin-visualizer": "^5.14.0",
		"sass": "^1.100.0",
		"source-map-explorer": "^2.5.3",
		"styled-jsx": "^5.1.7",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"unocss": "^0.58.9",
		"vite": "^8.0.14",
		"vite-bundle-explorer": "1.0.0",
		"vite-plugin-compression2": "2.5.3",
		"vite-plugin-oxlint": "2.1.1",
		"vite-plugin-svgr": "^4.5.0",
		"vitest": "4.1.5"
	}
}
