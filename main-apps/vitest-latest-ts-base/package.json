{
	"name": "vitest-latest-ts-base",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:local": "pnpm dev --mode _local",
		"testing": "pnpm dev --mode testing",
		"staging": "pnpm dev --mode staging",
		"build:testing": "pnpm build-only --mode testing && pnpm type-check",
		"build:staging": "pnpm build-only --mode staging && pnpm tsc-only",
		"build:prod": "pnpm build-only --mode production && pnpm tsc-prod",
		"build-only": "vite build",
		"analyze": "source-map-explorer 'dist/dist_staging/main-vite-react/assets/*.js'",
		"preview": "vite preview",
		"tsc-prod": "tsc -p ./tsconfig.prod.json",
		"tsc-only": "tsc --noEmit",
		"type-check": "tsc --noEmit -p tsconfig.test.json --composite false",
		"lint": "biome lint --write .",
		"lint-staged": "lint-staged",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts"
	},
	"dependencies": {
		"@ant-design/icons": "6.2.2",
		"@micro-zoe/micro-app": "1.0.0-rc.30",
		"antd": "6.3.7",
		"axios-ajax-ts": "workspace:^",
		"classnames": "2.5.1",
		"dayjs": "1.11.20",
		"lodash-es": "4.18.1",
		"mockjs": "1.1.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-router-dom": "7.14.2",
		"zustand": "5.0.12"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@swc/core": "^1.4.2",
		"@tailwindcss/postcss": "^4.0.14",
		"@tailwindcss/vite": "^4.0.14",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/babel__core": "^7.20.5",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^24.12.2",
		"@types/postcss-pxtorem": "^6.0.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/react-router-dom": "^5.3.3",
		"@biomejs/biome": "^1.9.4",
		"@unoCSS/preset-attributify": "npm:@unocss/preset-attributify@^0.58.6",
		"@unoCSS/preset-icons": "npm:@unocss/preset-icons@^0.58.6",
		"@unoCSS/preset-uno": "npm:@unocss/preset-uno@^0.58.6",
		"@vitejs/plugin-basic-ssl": "^1.1.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitejs/plugin-react-swc": "^3.5.0",
		"@vitest/coverage-c8": "^0.33.0",
		"@vitest/coverage-v8": "4.1.5",
		"@vitest/ui": "^1.1.1",
		"autoprefixer": "^10.4.16",
		"babel-plugin-react-compiler": "^1.0.0",
		"code-inspector-plugin": "^0.20.17",
		"cssnano": "^6.0.2",
		"globals": "^17.5.0",
		"jsdom": "29.1.1",
		"less": "^4.2.0",
		"postcss": "^8.4.32",
		"postcss-load-config": "^5.0.3",
		"postcss-preset-env": "^9.3.0",
		"postcss-pxtorem": "^6.1.0",
		"rollup-plugin-visualizer": "^5.12.0",
		"sass": "^1.69.6",
		"source-map-explorer": "^2.5.3",
		"styled-jsx": "^5.1.2",
		"tailwindcss": "^4.0.14",
		"typescript": "~6.0.2",
		"unocss": "^0.58.6",
		"unplugin-swc": "^1.4.4",
		"vite": "^8.0.10",
		"vitest": "4.1.5"
	}
}