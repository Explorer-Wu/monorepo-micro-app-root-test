{
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"rules": {
		"correctness": "warn",
		"suspicious": "warn",
		"perf": "warn",
		"complexity": "off",
		"regex": "warn",
		"style": "off",
		"no-unused-vars": "off",
		"@typescript-eslint/no-unused-vars": "off",
		"eslint-plugin-import/no-unresolved": [
			"warn",
			{
				"ignore": ["@/*", "tests"]
			}
		]
	}
}
